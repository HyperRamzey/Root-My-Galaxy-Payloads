diff --git a/kernel/compat/samsung_ashmem.c b/kernel/compat/samsung_ashmem.c
new file mode 100644
index 0000000..7b3e11e
--- /dev/null
+++ b/kernel/compat/samsung_ashmem.c
@@ -0,0 +1,109 @@
+#include <linux/compiler.h>
+#include <linux/errno.h>
+
+#include "compat/samsung_ashmem.h"
+#include "infra/symbol_resolver.h"
+#include "klog.h"
+
+/*
+ * Repair the CVE-2026-43499 payload's ashmem fops hijack residue.
+ *
+ * The exploit's slide forges an rb_node at the base of its own fake
+ * file_operations table and the erase deposits the child pointer at node+8,
+ * i.e. exactly the table's ->llseek slot. That slot therefore always holds
+ * the ashmem_misc.fops slot address (non-executable .data) after a
+ * successful hijack. The first lseek() on any post-hijack ashmem fd - the
+ * standard ASharedMemory_getSize lseek(fd, 0, SEEK_END) idiom, hit during IME
+ * bringup - then branches to .data and IABTs the kernel (pc =
+ * ashmem_misc+0x10 from __arm64_sys_lseek, proven on F946BXXS7GZH2).
+ *
+ * The payload cannot repair this itself: its slide only writes data
+ * pointers and its configfs writer reaches .data only, while the slot needs
+ * a text address in a slab page. This module, running in kernel context,
+ * performs the repair with a plain kernel write. All addresses are resolved
+ * from the running kernel's kallsyms, so this is firmware-independent.
+ *
+ * Fail-closed policy: if the table looks like the payload's (open slot is
+ * the genuine ashmem_open) but the genuine llseek cannot be resolved, refuse
+ * to load - arming a known panic is worse than no KSU. Any other state
+ * (genuine table, already repaired, foreign table, no ashmem) is a no-op
+ * success.
+ */
+
+#ifdef CONFIG_KSU_SAMSUNG_KDP
+
+/* struct miscdevice (include/linux/miscdevice.h, stable on 5.15):
+ * int minor @0, const char *name @8, const struct file_operations *fops @0x10.
+ * struct file_operations (include/linux/fs.h): llseek @0x08, open @0x70. */
+#define SAMSUNG_ASHMEM_MISC_FOPS_OFF 0x10u
+#define SAMSUNG_ASHMEM_FOPS_LLSEEK_SLOT 1u
+#define SAMSUNG_ASHMEM_FOPS_OPEN_SLOT (0x70u / sizeof(void *))
+
+int ksu_samsung_ashmem_repair(void)
+{
+	void *ashmem_misc;
+	void *ashmem_llseek;
+	void *ashmem_open;
+	void **fops;
+	const void *got_open;
+	const void *got_llseek;
+
+	ashmem_misc = (void *)find_kernel_symbol_exact("ashmem_misc");
+	if (!ashmem_misc) {
+		pr_info("Samsung ashmem repair: ashmem_misc not found, skipping\n");
+		return 0;
+	}
+
+	fops = (void **)READ_ONCE(
+		*(void *const *)((char *)ashmem_misc + SAMSUNG_ASHMEM_MISC_FOPS_OFF));
+	if (!fops) {
+		pr_info("Samsung ashmem repair: misc fops is NULL, skipping\n");
+		return 0;
+	}
+
+	ashmem_open = (void *)find_kernel_symbol_exact("ashmem_open");
+	got_open = READ_ONCE(fops[SAMSUNG_ASHMEM_FOPS_OPEN_SLOT]);
+	if (!ashmem_open || got_open != ashmem_open) {
+		/* Genuine table (open is real but llseek slot differs from ours
+		 * only when hijacked), already-repaired table, or a foreign
+		 * table: nothing to do. */
+		pr_info("Samsung ashmem repair: table %px not payload-owned "
+			"(open=%px want=%px), skipping\n",
+			fops, got_open, ashmem_open);
+		return 0;
+	}
+
+	ashmem_llseek = (void *)find_kernel_symbol_exact("ashmem_llseek");
+	if (!ashmem_llseek) {
+		pr_err("Samsung ashmem repair: ashmem_llseek unresolvable, "
+		       "refusing to arm the hijack\n");
+		return -ENOENT;
+	}
+
+	got_llseek = READ_ONCE(fops[SAMSUNG_ASHMEM_FOPS_LLSEEK_SLOT]);
+	if (got_llseek == ashmem_llseek) {
+		pr_info("Samsung ashmem repair: llseek already genuine, nothing to do\n");
+		return 0;
+	}
+
+	WRITE_ONCE(fops[SAMSUNG_ASHMEM_FOPS_LLSEEK_SLOT], ashmem_llseek);
+
+	if (READ_ONCE(fops[SAMSUNG_ASHMEM_FOPS_LLSEEK_SLOT]) != ashmem_llseek) {
+		pr_err("Samsung ashmem repair: llseek writeback verification failed, "
+		       "refusing to arm the hijack\n");
+		return -EIO;
+	}
+
+	pr_info("Samsung ashmem repair: fake fops %px llseek %px -> genuine %px\n",
+		fops, got_llseek, ashmem_llseek);
+	return 0;
+}
+
+#else
+
+int ksu_samsung_ashmem_repair(void)
+{
+	return 0;
+}
+
+#endif
diff --git a/kernel/compat/samsung_ashmem.h b/kernel/compat/samsung_ashmem.h
new file mode 100644
index 0000000..643d226
--- /dev/null
+++ b/kernel/compat/samsung_ashmem.h
@@ -0,0 +1,6 @@
+#ifndef __KSU_SAMSUNG_ASHMEM_H
+#define __KSU_SAMSUNG_ASHMEM_H
+
+int ksu_samsung_ashmem_repair(void);
+
+#endif
diff --git a/kernel/core/init.c b/kernel/core/init.c
index 62ed640..d9338de 100644
--- a/kernel/core/init.c
+++ b/kernel/core/init.c
@@ -28,6 +28,7 @@
 #include "feature/selinux_hide.h"
 #include "infra/symbol_resolver.h"
 #include "compat/samsung_defex.h"
+#include "compat/samsung_ashmem.h"
 
 #if defined(__x86_64__) && !defined(CONFIG_KSU_X86_PATCH_SYSCALL_DISPATCHER)
 #include <asm/cpufeature.h>
@@ -147,6 +148,17 @@ int __init kernelsu_init(void)
         return ret;
     }
 
+    /* Repair the exploit's ashmem fops hijack residue (fake table llseek
+     * clobber) before any userspace can lseek an ashmem fd. Fail closed:
+     * without the repair the first IME bringup would panic the kernel. */
+    ret = ksu_samsung_ashmem_repair();
+    if (ret) {
+        ksu_samsung_defex_exit();
+        ksu_put_cred(ksu_cred);
+        ksu_samsung_kdp_exit();
+        return ret;
+    }
+
     ksu_syscall_hook_init();
 
     ksu_feature_init();
